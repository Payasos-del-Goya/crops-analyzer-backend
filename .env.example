# Copia este fichero a .env (no se sube a git) y rellena lo que haga falta.
# Todo es opcional: sin valor se usa el de config.py.

# InfluxDB
INFLUX_URL=http://fieldshift-gw.local:8086
# INFLUX_TOKEN=

# Token de solo lectura del bucket `icinga` (estado UP/DOWN de las balizas).
# Ya viene por defecto en config.py; solo hace falta si se cambia.
# INFLUX_ICINGA_TOKEN=

# Cada cuántos segundos se consulta InfluxDB para el WebSocket /ws/monitor
# MONITOR_WS_INTERVAL=5

# PostgreSQL
# POSTGRES_HOST=fieldshift-gw.local
# POSTGRES_PASSWORD=
